# KEY_PARAMS=Vtso,Vco,Vch,Vsat,Gamma,Gmmax,Deltgm,Peff,Kapa,Alpha,Mu,DVcoVgo,DVgoVto
KEY_PARAMS=Vtso,Vco,Vch,Vsat,Gamma,Gmmax,Deltgm,Peff,Kapa,Alpha,Mu,DVcoVgo,DVtsoVto
TEMPERATURE=300
EPSILON=1e-15

# VA_FILE_PATH=env/eehemt/eehemt114_2_new.va
VA_FILE_PATH=env/eehemt/eehemt114_5-GIDL.va
CSV_FILE_PATH=data/eehemt/id_vgvd.csv
ALL_POSSIBLE_KEY_PARAMS_PATH=data/eehemt/hemt_key_params.json

CURVE_CONDITION_NAMES=Vds
N_FEATURES_PER_CURVE=6
OBS_ERR_BOUND=1e6
OBSERVATION_FILTER=NoFilter

## === Env Step ===
MAX_EPISODE_STEPS=500
# 1000 -> 1500 -> 2000 -> 4000 -> 2000 -> 1000 -> 500 -> 100
REWARD_ALPHA=0.1
HUBER_DELTA=1.0
ARCSINH_HUBER_THRESHOLD=1e-5
NRMSE_THRESHOLD=5.0
# 1.0 -> 0.5 -> 0.8

REWARD_MIN=-5.0
REWARD_MAX=5.0

HARDNESS_THRESHOLD=600.0

# STAGNATION_PATIENCE_STEPS=250
# # 50 -> 200
# STAGNATION_THRESHOLD=1e-5
# # 1e-6 -> 1e-3 -> 1e-4

NUM_ENV_RUNNERS=2
# 2 -> 4 -> 10 -> 6 -> 4 -> 2

## === Training ===
ALGO_NAME=ppo
NUM_LEARNERS=6
TRAIN_BATCH_SIZE_PER_LEARNER=2048  # PPO
# 4096 -> 2048 -> 1024

MINIBATCH_SIZE=512  # PPO
# 512 -> 128 -> 64 -> 256 -> 512 -> 256

NUM_EPOCHS=8
LR=5e-5
# 1e-4 -> 5e-5
ENTROPY_COEFF=1e-4
# 1e-4 -> 1e-3
VF_LOSS_COEFF=0.1
N_ITERATIONS=400
# 50
EPISODE_REWARD_MEAN=1.0
# RESTORE_PATH=result/ckpt/EEHEMT_PPO/PPO_EEHEMTEnv_Measure_VDS_12840_00000_0_2026-02-05_20-06-15

## === IR Drop (external resistance) ===
RS_EXT=0.0
RD_EXT=0.4
# 0.4 -> 0.0
IR_DROP_N_ITER=2
IR_DROP_MAXFEV=500
IR_DROP_RESIDUAL_TOL=1e-8

## === Evaluation ===
PLOT_DIR=result/iv_curve/
