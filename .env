# 512 -> 128 -> 64
# MINIBATCH_SIZE=32  # SAC

NUM_EPOCHS=8
LR=5e-5
# 1e-4 -> 5e-5
ACTOR_LR=3e-5  # SAC
CRITIC_LR=3e-4  # SAC
ENTROPY_COEFF=1e-4
# 1e-4 -> 1e-3
N_ITERATIONS=50
# 50
NUM_STEPS_SAMPLED_BEFORE_LEARNING_STARTS=1500  # SAC
EPISODE_REWARD_MEAN=1.0

## === Evaluation ===
