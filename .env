# STAGNATION_THRESHOLD=1e-5
# # 1e-6 -> 1e-3 -> 1e-4

NUM_ENV_RUNNERS=2
# 2 -> 4 -> 10 -> 6 -> 4 -> 2

## === Training ===
ALGO_NAME=ppo
NUM_LEARNERS=6
TRAIN_BATCH_SIZE_PER_LEARNER=2048  # PPO
# 4096 -> 2048 -> 1024
# TRAIN_BATCH_SIZE_PER_LEARNER=256  # SAC

